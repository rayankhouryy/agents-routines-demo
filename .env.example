# ── Foundry project ──────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# ── Azure control plane (used for the container build + RBAC) ────────
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group>
FOUNDRY_ACCOUNT_NAME=<foundry-account-name>

# ── Container registry (image is built in Azure, not locally) ────────
ACR_NAME=<acr-name>
IMAGE_REPOSITORY=pepsico/store-ops-agent
IMAGE_TAG=v1

# ── Names (optional overrides) ───────────────────────────────────────
HOSTED_AGENT_NAME=pepsico-store-ops-agent
PROMPT_AGENT_NAME=pepsico-exec-digest-agent
HOSTED_ROUTINE_NAME=pepsico-daily-store-ops
PROMPT_ROUTINE_NAME=pepsico-weekly-exec-digest
